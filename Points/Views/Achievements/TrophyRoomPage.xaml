<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Points.ViewModels"
             x:Class="Points.Views.Achievements.TrophyRoomPage"
             Title="Trophy Room">

    <!--<ContentPage.BindingContext>
        <vm:TrophyRoomViewModel />
    </ContentPage.BindingContext>-->

    <Grid Padding="12">
        <CollectionView ItemsSource="{Binding Trophies}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <!-- 2 per row minimum -->
                <GridItemsLayout Orientation="Vertical"
                                 Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="6"
                           Padding="10"
                           CornerRadius="12"
                           HasShadow="True">

                        <!-- Square card layout -->
                        <Grid RowDefinitions="*,Auto,Auto"
                              RowSpacing="8"
                              HeightRequest="170">

                            <Image Grid.Row="0"
                                   Source="{Binding ImageSource}"
                                   Aspect="AspectFit" />

                            <Label Grid.Row="1"
                                   VerticalOptions="Center"
                                   Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation" />

                            <Label Grid.Row="2"
                                   VerticalOptions="Center"
                                   Text="{Binding EarnedOnText}"
                                   FontSize="12"
                                   TextColor="Gray" />

                            <Button 
                                Grid.Row="2"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                BackgroundColor="Black"
                                Margin="0"
                                HeightRequest="40"
                                Text="⧉"
                                FontSize="12"
                                TextColor="Gray"
                                Clicked="OnViewTrophyClicked"
                                CommandParameter="{Binding .}" />

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
