<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Points.ViewModels.Achievements"
             xmlns:cards="clr-namespace:Points.Views.Cards;assembly=Points"
             x:Class="Points.Views.Achievements.AchievementsPage"
             Title="Achievements">

    <!--<ContentPage.BindingContext>
        <vm:AchievementsViewModel />
    </ContentPage.BindingContext>-->

    <Grid RowDefinitions="*,Auto" Padding="12">

        <CarouselView Grid.Row="0"
                  ItemsSource="{Binding Pages}"
                  Position="{Binding Position, Mode=TwoWay}">

            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="Auto,*">

                        <Label Grid.Row="0"
                           Text="{Binding Name}"
                           FontSize="18"
                           Margin="0,0,0,8" />

                        <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding Cards}"
                                    ItemTemplate="{StaticResource AchievementSelector}">
                            <CollectionView.EmptyView>
                                <Grid Padding="24">
                                    <Label Text="{Binding EmptyStateText}"
                                           TextColor="Gray"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>

        </CarouselView>

        <!-- BOTTOM TOOLBAR -->
        <Grid Grid.Row="1"
          ColumnDefinitions="*,Auto,Auto"
          Padding="12"
          BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#1E1E1E}">

            <!-- Left: Trophy Room -->
            <Button Grid.Column="0"
                Text="🏆"
                Command="{Binding OpenTrophyRoomCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="Start"
                VerticalOptions="Center"/>

            <!-- Right: Order Mode -->
            <Button Grid.Column="1"
                Text="↕"
                Command="{Binding ToggleOrderModeCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0,0,8,0"
                TextColor="White"
                BackgroundColor="Black"
                VerticalOptions="Center">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsOrderMode}" Value="True">
                        <Setter Property="BackgroundColor" Value="Green" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Right: Add Achievement -->
            <Button Grid.Column="2"
                Text="Add"
                Command="{Binding AddAchievementCommand}"
                VerticalOptions="Center"
                TextColor="White"
                BackgroundColor="Green"/>
        </Grid>

    </Grid>


    <ContentPage.Resources>
        <ResourceDictionary>
            <cards:CardTemplateSelector x:Key="AchievementSelector">
                <cards:CardTemplateSelector.AchievementTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto">
                            <cards:AchievementCardView Grid.Column="0" />
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6"
                                                 VerticalOptions="Center"
                                                 IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AchievementsViewModel}}, Path=IsOrderMode}">
                                <Button Text="^"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        Padding="0"
                                        TextColor="White"
                                        BackgroundColor="Black"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AchievementsViewModel}}, Path=MoveAchievementUpCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Text="v"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        Padding="0"
                                        TextColor="White"
                                        BackgroundColor="Black"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AchievementsViewModel}}, Path=MoveAchievementDownCommand}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </cards:CardTemplateSelector.AchievementTemplate>
            </cards:CardTemplateSelector>
        </ResourceDictionary>
    </ContentPage.Resources>


</ContentPage>
