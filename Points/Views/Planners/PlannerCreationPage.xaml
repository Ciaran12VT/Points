<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Points.Views.Planners.PlannerCreationPage"
             xmlns:controls="clr-namespace:Points.CustomComponents"
             Title="PlannerCreationPage">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Dropdown -->
        <Picker Grid.Row="0"
                Title="Select Period"
                ItemsSource="{Binding PeriodOptions}"
                SelectedItem="{Binding SelectedPeriod}"
                HorizontalOptions="Fill"
            />

        <CollectionView Grid.Row="1" x:Name="RowsList" ItemsSource="{Binding Rows}" SelectionMode="Single" SelectionChanged="RowsList_SelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <controls:PlannerProgressCard />
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Save button pinned to bottom (matches TatDetailsPage style) -->
        <Button Grid.Row="2"
                Text="Save"
                BackgroundColor="Green"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="21"
                HeightRequest="48"
                Command="{Binding SaveCommand}"/>

    </Grid>

</ContentPage>