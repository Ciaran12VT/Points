<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Points.ViewModels"
             xmlns:cards="clr-namespace:Points.Views.Cards;assembly=Points"
             xmlns:views="clr-namespace:Points.Views.Cards;assembly=Points"
             xmlns:converters="clr-namespace:Points.Converters"
             xmlns:customComponents="clr-namespace:Points.CustomComponents;assembly=Points"
             x:Class="Points.Views.HomePage"
             Title="Points">

    <!--<ContentPage.BindingContext>
        <vm:HomeViewModel />
    </ContentPage.BindingContext>-->
    

    <!-- TOP TOOLBAR (in the actual top title bar area) -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
          Padding="12,0"
          VerticalOptions="Center"
          ColumnSpacing="6">

            <!-- Left: Header date + active phase -->
            <VerticalStackLayout Grid.Column="0"
                             Spacing="0"
                             VerticalOptions="Center">

                <Label Text="{Binding HeaderDate}"
                   FontSize="22"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"/>

                <Label Text="{Binding ActivePhaseName}"
                   FontSize="22"
                   TextColor="{Binding ActivePhaseColor}"
                   HorizontalOptions="Start"/>
                
            </VerticalStackLayout>

            <!-- Warning -->
            <Label Grid.Column="2"
               Text="!"
               TextColor="Red"
               FontSize="26"
               FontAttributes="Bold"
               IsVisible="{Binding HasNegativeAvailableMission}"
               VerticalOptions="Center" />

            <!-- Top-right value -->
            <Label Grid.Column="3"
               Text="{Binding TopRightValue, StringFormat='{0:F2}'}"
               FontSize="26"
               VerticalOptions="Center"
               HorizontalOptions="End"
               TextColor="{Binding TopRightValue, Converter={StaticResource GlobalValueColorConverter}}" />
        </Grid>
    </Shell.TitleView>



    <!-- PAGE CONTENT: top toolbar + carousel + bottom toolbar -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- TOP (IN-PAGE) TOOLBAR -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="12"
              BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#1E1E1E}">

            <!-- Left-hand button group -->
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">

                <!-- Achievements -->
                <Button Text="🏆"
                    Command="{Binding OpenAchievementsCommand}"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    Margin="0"
                    TextColor="White"
                    BackgroundColor="Black"
                    VerticalOptions="Center"/>

                <!-- Reports -->
                <Button Text="📊"
                Command="{Binding OpenReportsCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                VerticalOptions="Center"/>


                <!-- Date Range -->
                <!--<Button Text="📅"
                Command="{Binding OpenDateRangePickerViewCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                VerticalOptions="Center"/>-->

                <!-- Planners -->
                <Button Text="🎯"
                Command="{Binding OpenPlannerViewCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                VerticalOptions="Center"/>

            </HorizontalStackLayout>

            <!-- Right-hand Settings button -->
            <Button Grid.Column="1"
            Command="{Binding OpenSettingsCommand}"
            Text="⚙️"
            WidthRequest="36"
            HeightRequest="36"
            CornerRadius="18"
            Padding="0"
            Margin="0"
            TextColor="White"
            BackgroundColor="Black"
            VerticalOptions="Center"/>
        </Grid>


        <!-- NEW: DYNAMIC (IN-PAGE) TOOLBAR -->
        <Grid Grid.Row="1"
              Padding="12,0,12,12"
              BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#1E1E1E}">

            <!-- Horizontal scrolling button row -->
            <CollectionView ItemsSource="{Binding Pages}"
                    ItemsLayout="HorizontalList"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button Text="{Binding IconChar}"
                        WidthRequest="20"
                        HeightRequest="20"
                        CornerRadius="18"
                        Padding="0"
                        Margin="0,0,8,0"
                        TextColor="White"
                        BackgroundColor="{Binding BackColor}"
                        VerticalOptions="Center"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=NavigationItemClickedCommand}"
                        CommandParameter="{Binding .}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>

        <!-- Carousel -->
        <CarouselView Grid.Row="2" x:Name="MainCarousel"
                      ItemsSource="{Binding Pages}"
                      Position="{Binding Position, Mode=TwoWay}"
                      ItemTemplate="{StaticResource HomePaneTemplateSelector}"
                      IsSwipeEnabled="True"
                      PositionChanged="Carousel_PositionChanged">

            <!--<CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="Auto,*" Padding="12,8">
                         Pane title 
                        <Label Grid.Row="0"
                           Text="{Binding Name}"
                           FontSize="18"
                           Margin="0,0,0,8" />

                         Cards list
                        <CollectionView 
                            x:Name="CardsList"
                            Grid.Row="1" 
                            ItemsSource="{Binding VisibleCards}" 
                            ItemTemplate="{StaticResource CardTemplateSelector}"
                            Scrolled="Cards_Scrolled">

                        </CollectionView>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>-->


        </CarouselView>


        <!-- BOTTOM TOOLBAR -->
        <Grid Grid.Row="3"
                  ColumnDefinitions="*,Auto"
                  Padding="12"
                  BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#1E1E1E}">

            <!-- Left-hand button group -->
            <HorizontalStackLayout Grid.Column="0"
                           Spacing="8"
                           VerticalOptions="Center">

                <!-- DEBUG NOTIFICATION BUTTON -->
                <!--<Button Text="🔔"
                    Clicked="OnDebugNotificationClicked"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    Margin="0"
                    TextColor="White"
                    BackgroundColor="Black"
                    HorizontalOptions="End"
                    VerticalOptions="Center"/>-->

                <Button Text="*"
                Command="{Binding ClearFiltersCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

                <Button Text="A"
                    Command="{Binding ScrollToActiveCardCommand}"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    Margin="0"
                    BackgroundColor="Black"
                    VerticalOptions="Center">

                    <Button.Triggers>
                        <!-- No active card -->
                        <DataTrigger TargetType="Button"
                     Binding="{Binding HasActiveCard}"
                     Value="False">
                            <Setter Property="TextColor" Value="Gray" />
                        </DataTrigger>

                        <!-- Active card exists -->
                        <DataTrigger TargetType="Button"
                     Binding="{Binding HasActiveCard}"
                     Value="True">
                            <Setter Property="TextColor" Value="DodgerBlue" />
                        </DataTrigger>
                    </Button.Triggers>

                </Button>


                <Button Text="🕑"
                Command="{Binding SortByLastActiveCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

                <Button Text="-"
                Command="{Binding FilterNegativeCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

                <Button Text="+"
                Command="{Binding FilterPositiveCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

                <Button Text="#"
                Command="{Binding FilterByTagCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

                <Button Text="🔎"
                Clicked="OnTextSearchClicked"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

            </HorizontalStackLayout>

            <!-- Right-hand Add button -->
            <Button Grid.Column="1"
            Text="Add"
            Command="{Binding AddCardCommand}"
            VerticalOptions="Center"
            TextColor="White"
            BackgroundColor="Green"/>

        </Grid>


    </Grid>

    <ContentPage.Resources>
        <ResourceDictionary>
            <cards:CardTemplateSelector x:Key="CardTemplateSelector">
                
                <cards:CardTemplateSelector.TatTemplate>
                    <DataTemplate>
                        <cards:TatCardView />
                    </DataTemplate>
                </cards:CardTemplateSelector.TatTemplate>

                <cards:CardTemplateSelector.ScTemplate>
                    <DataTemplate>
                        <cards:ScCardView />
                    </DataTemplate>
                </cards:CardTemplateSelector.ScTemplate>

                <cards:CardTemplateSelector.MissionTemplate>
                    <DataTemplate>
                        <cards:MissionCardView />
                    </DataTemplate>
                </cards:CardTemplateSelector.MissionTemplate>

                <cards:CardTemplateSelector.BudgetTemplate>
                    <DataTemplate>
                        <cards:BudgetCardView />
                    </DataTemplate>
                </cards:CardTemplateSelector.BudgetTemplate>

                <cards:CardTemplateSelector.PlannerTemplate>
                    <DataTemplate>
                        <customComponents:PlannerProgressCard />
                    </DataTemplate>
                </cards:CardTemplateSelector.PlannerTemplate>

                <cards:CardTemplateSelector.DateHeaderCardTemplate>
                    <DataTemplate>
                        <Grid Padding="8,10">
                            <Label Text="{Binding Title}"
                               FontSize="13"
                               FontAttributes="Bold,Italic"
                               Opacity="0.8" />
                        </Grid>
                    </DataTemplate>
                </cards:CardTemplateSelector.DateHeaderCardTemplate>

                <cards:CardTemplateSelector.AchievementTemplate>
                    <DataTemplate>
                        <cards:AchievementCardView />
                    </DataTemplate>
                </cards:CardTemplateSelector.AchievementTemplate>

                <cards:CardTemplateSelector.TrackerTemplate>
                    <DataTemplate>
                        <cards:TrackerCardView
                            Title="{Binding Title}"
                            Unit="{Binding Unit}"
                            Values="{Binding Values}"
                            FirstRecordedDate="{Binding FirstRecordedDate}"
                            AddValueCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=AddTrackerValueCommand}"/>

                    </DataTemplate>
                </cards:CardTemplateSelector.TrackerTemplate>

            </cards:CardTemplateSelector>

            <converters:GlobalValueColorConverter x:Key="GlobalValueColorConverter" />
            
            <cards:HomePaneTemplateSelector x:Key="HomePaneTemplateSelector">

                <cards:HomePaneTemplateSelector.DefaultPaneTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,*" Padding="12,8">
                            <Label Grid.Row="0"
                                   Text="{Binding Name}"
                                   FontSize="18"
                                   Margin="0,0,0,8" />

                            <CollectionView x:Name="CardsList"
                                            Grid.Row="1"
                                            ItemsSource="{Binding VisibleCards}"
                                            ItemTemplate="{StaticResource CardTemplateSelector}"
                                            Scrolled="Cards_Scrolled"
                                            Loaded="CardsList_Loaded"
                                            Unloaded="CardsList_Unloaded" />
                        </Grid>
                    </DataTemplate>
                </cards:HomePaneTemplateSelector.DefaultPaneTemplate>

                <cards:HomePaneTemplateSelector.DashboardPaneTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,*" Padding="12,8">

                            <Label Grid.Row="0"
                                   Text="{Binding Name}"
                                   FontSize="18"
                                   Margin="0,0,0,8" />

                            <CollectionView Grid.Row="1"
                                            ItemsSource="{Binding DashboardCells}"
                                            SelectionMode="None">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="12" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4">
                                            <Button Text="{Binding IconChar}"
                                                    BackgroundColor="{Binding BackColor}"
                                                    TextColor="White"
                                                    FontSize="35"
                                                    CornerRadius="18"
                                                    HeightRequest="74"
                                                    WidthRequest="74"
                                                    Padding="0"
                                                    Clicked="DashboardShortcutButton_Clicked"
                                                    Pressed="DashboardShortcutButton_Pressed"
                                                    Released="DashboardShortcutButton_Released"
                                                    Unfocused="DashboardShortcutButton_Released">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button"
                                                                 Binding="{Binding IsPlaceholder}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                            </CollectionView>
                        </Grid>
                    </DataTemplate>
                </cards:HomePaneTemplateSelector.DashboardPaneTemplate>

            </cards:HomePaneTemplateSelector>
            
        </ResourceDictionary>
    </ContentPage.Resources>


</ContentPage>
