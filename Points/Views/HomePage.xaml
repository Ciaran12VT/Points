<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Points.ViewModels"
             xmlns:cards="clr-namespace:Points.Views.Cards;assembly=Points"
             xmlns:views="clr-namespace:Points.Views.Cards;assembly=Points"
             xmlns:converters="clr-namespace:Points.Converters"
             x:Class="Points.Views.HomePage"
             Title="Points">

    <!--<ContentPage.BindingContext>
        <vm:HomeViewModel />
    </ContentPage.BindingContext>-->
    

    <!-- TOP TOOLBAR (in the actual top title bar area) -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto"
          Padding="12,0"
          VerticalOptions="Center"
          ColumnSpacing="6">

            <Label Grid.Column="0"
               Text="{Binding HeaderDate}"
               FontSize="26"
               VerticalOptions="Center" 
               HorizontalOptions="Start"/>

            <Label Grid.Column="1"
               Text="!"
               TextColor="Red"
               FontSize="26"
               FontAttributes="Bold"
               IsVisible="{Binding HasNegativeAvailableMission}"
               VerticalOptions="Center" />

            <Label Grid.Column="2"
               Text="{Binding TopRightValue, StringFormat='{0:F2}'}"
               FontSize="26"
               VerticalOptions="Center"
               HorizontalOptions="End"
               TextColor="{Binding TopRightValue, Converter={StaticResource GlobalValueColorConverter}}" />
        </Grid>
    </Shell.TitleView>


    <!-- PAGE CONTENT: top toolbar + carousel + bottom toolbar -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOP (IN-PAGE) TOOLBAR -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="12"
              BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#1E1E1E}">

            <!-- Left-hand button group -->
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">

                <!-- Achievements -->
                <Button Text="🏆"
                    Command="{Binding OpenAchievementsCommand}"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    Margin="0"
                    TextColor="White"
                    BackgroundColor="Black"
                    VerticalOptions="Center"/>

                <!-- Reports -->
                <Button Text="📊"
                Command="{Binding OpenReportsCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                VerticalOptions="Center"/>


                <!-- Date Range -->
                <Button Text="📅"
                Command="{Binding OpenDateRangePickerViewCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                VerticalOptions="Center"/>

            </HorizontalStackLayout>

            <!-- Right-hand Settings button -->
            <Button Grid.Column="1"
            Command="{Binding OpenSettingsCommand}"
            Text="⚙️"
            WidthRequest="36"
            HeightRequest="36"
            CornerRadius="18"
            Padding="0"
            Margin="0"
            TextColor="White"
            BackgroundColor="Black"
            VerticalOptions="Center"/>
        </Grid>

        <!-- Carousel -->
        <CarouselView Grid.Row="1" x:Name="MainCarousel"
                      ItemsSource="{Binding Pages}"
                      Position="{Binding Position, Mode=TwoWay}"
                      IsSwipeEnabled="True"
                      PositionChanged="Carousel_PositionChanged">

            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="Auto,*" Padding="12,8">
                         <!--Pane title--> 
                        <Label Grid.Row="0"
                           Text="{Binding Name}"
                           FontSize="18"
                           Margin="0,0,0,8" />

                         <!--Cards list-->
                        <CollectionView 
                            x:Name="CardsList"
                            Grid.Row="1" 
                            ItemsSource="{Binding VisibleCards}" 
                            ItemTemplate="{StaticResource CardTemplateSelector}"
                            Scrolled="Cards_Scrolled">

                        </CollectionView>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>


        </CarouselView>

        <!-- BOTTOM TOOLBAR -->
        <Grid Grid.Row="2"
      ColumnDefinitions="*,Auto"
      Padding="12"
      BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#1E1E1E}">

            <!-- Left-hand button group -->
            <HorizontalStackLayout Grid.Column="0"
                           Spacing="8"
                           VerticalOptions="Center">

                <Button Text="*"
                Command="{Binding ClearFiltersCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

                <Button Text="A"
                    Command="{Binding ScrollToActiveCardCommand}"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    Margin="0"
                    BackgroundColor="Black"
                    VerticalOptions="Center">

                    <Button.Triggers>
                        <!-- No active card -->
                        <DataTrigger TargetType="Button"
                     Binding="{Binding HasActiveCard}"
                     Value="False">
                            <Setter Property="TextColor" Value="Gray" />
                        </DataTrigger>

                        <!-- Active card exists -->
                        <DataTrigger TargetType="Button"
                     Binding="{Binding HasActiveCard}"
                     Value="True">
                            <Setter Property="TextColor" Value="DodgerBlue" />
                        </DataTrigger>
                    </Button.Triggers>

                </Button>


                <Button Text="🕑"
                Command="{Binding SortByLastActiveCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

                <Button Text="-"
                Command="{Binding FilterNegativeCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

                <Button Text="+"
                Command="{Binding FilterPositiveCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

                <Button Text="#"
                Command="{Binding FilterByTagCommand}"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

                <Button Text="🔎"
                Clicked="OnTextSearchClicked"
                WidthRequest="36"
                HeightRequest="36"
                CornerRadius="18"
                Padding="0"
                Margin="0"
                TextColor="White"
                BackgroundColor="Black"
                HorizontalOptions="End"
                VerticalOptions="Center"/>

            </HorizontalStackLayout>

            <!-- Right-hand Add button -->
            <Button Grid.Column="1"
            Text="Add"
            Command="{Binding AddCardCommand}"
            VerticalOptions="Center"
            TextColor="White"
            BackgroundColor="Green"/>

        </Grid>


    </Grid>

    <ContentPage.Resources>
        <ResourceDictionary>
            <cards:CardTemplateSelector x:Key="CardTemplateSelector">
                
                <cards:CardTemplateSelector.TatTemplate>
                    <DataTemplate>
                        <cards:TatCardView />
                    </DataTemplate>
                </cards:CardTemplateSelector.TatTemplate>

                <cards:CardTemplateSelector.ScTemplate>
                    <DataTemplate>
                        <cards:ScCardView />
                    </DataTemplate>
                </cards:CardTemplateSelector.ScTemplate>

                <cards:CardTemplateSelector.MissionTemplate>
                    <DataTemplate>
                        <cards:MissionCardView />
                    </DataTemplate>
                </cards:CardTemplateSelector.MissionTemplate>

                <cards:CardTemplateSelector.BudgetTemplate>
                    <DataTemplate>
                        <cards:BudgetCardView />
                    </DataTemplate>
                </cards:CardTemplateSelector.BudgetTemplate>

                <cards:CardTemplateSelector.DateHeaderCardTemplate>
                    <DataTemplate>
                        <Grid Padding="8,10">
                            <Label Text="{Binding Title}"
                               FontSize="13"
                               FontAttributes="Bold"
                               Opacity="0.8" />
                        </Grid>
                    </DataTemplate>
                </cards:CardTemplateSelector.DateHeaderCardTemplate>

                <cards:CardTemplateSelector.AchievementTemplate>
                    <DataTemplate>
                        <cards:AchievementCardView />
                    </DataTemplate>
                </cards:CardTemplateSelector.AchievementTemplate>

                <cards:CardTemplateSelector.TrackerTemplate>
                    <DataTemplate>
                        <cards:TrackerCardView
                            Title="{Binding Title}"
                            Unit="{Binding Unit}"
                            Values="{Binding Values}"
                            FirstRecordedDate="{Binding FirstRecordedDate}"
                            AddValueCommand="{Binding AddValueCommand}"/>

                    </DataTemplate>
                </cards:CardTemplateSelector.TrackerTemplate>

            </cards:CardTemplateSelector>

            <converters:GlobalValueColorConverter x:Key="GlobalValueColorConverter" />
            
        </ResourceDictionary>
    </ContentPage.Resources>


</ContentPage>
