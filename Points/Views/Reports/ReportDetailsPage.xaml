<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Points.Views.Reports.ReportDetailsPage"
             Title="Report">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          Padding="12"
          RowSpacing="10">

        <!-- Title -->
        <Entry Grid.Row="0"
               Text="{Binding TitleText, Mode=TwoWay}"
               Placeholder="Report name"
               FontSize="20"
               FontAttributes="Bold" />


        <!-- SQL editor -->
        <Editor Grid.Row="1"
                Text="{Binding SqlText}"
                AutoSize="TextChanges"
                HeightRequest="180"
                FontFamily="Courier New"
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}" />

        <!-- Execute row -->
        <HorizontalStackLayout Grid.Row="2" Spacing="10" VerticalOptions="Center">
            <Button Text="Execute"
                    Command="{Binding ExecuteCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="Green"
                    TextColor="White" />

            <Button Text="⧉"
                    Command="{Binding CopyResultsCommand}"
                    IsEnabled="{Binding CanCopyResults}"
                    WidthRequest="48"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="Green"
                    TextColor="White"
                    SemanticProperties.Description="Copy report results to clipboard" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Results "Grid" (simple list for now) -->
        <Frame Grid.Row="3"
               Padding="8"
               CornerRadius="8"
               BorderColor="{AppThemeBinding Light=#DDDDDD, Dark=#333333}">

            <!-- Both-direction scroll so big result sets are viewable -->
            <ScrollView Orientation="Both">
                <Grid x:Name="ResultsGrid"
              Padding="6"
              ColumnSpacing="8"
              RowSpacing="4" />
            </ScrollView>

        </Frame>




        <!-- Results message -->
        <Editor Grid.Row="4"
                Text="{Binding ResultsMessage}"
                IsReadOnly="True"
                AutoSize="TextChanges"
                FontSize="12"
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}" />

        <!-- Action buttons -->
        <Grid Grid.Row="5"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">

            <Button Grid.Column="0"
            Text="Save"
            Command="{Binding SaveCommand}"
            BackgroundColor="Green"
            TextColor="White"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

            <Button Grid.Column="1"
            Text="Delete"
            Command="{Binding DeleteCommand}"
            BackgroundColor="#B00020"
            TextColor="White"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        </Grid>



    </Grid>
</ContentPage>
