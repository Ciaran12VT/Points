<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Points.Views.Shared.TimeWindowEditPage"
    Title="Time Window Edit">

    <Grid Padding="12" RowDefinitions="Auto,Auto,Auto, Auto" ColumnDefinitions="*,Auto" RowSpacing="10">

        <Label Grid.Row="0" Grid.ColumnSpan="2"
               Text="Time Window Edit"
               FontAttributes="Bold"
               FontSize="18"
               HorizontalOptions="Center"/>

        <!-- Start -->
        <Label Grid.Row="1" Grid.Column="0"
               Text="Start"
               FontAttributes="Italic"
               VerticalTextAlignment="Center"/>

        <TimePicker Grid.Row="1" Grid.Column="1"
                    x:Name="StartPicker"
                    Format="HH:mm"/>

        <!-- End -->
        <Label Grid.Row="2" Grid.Column="0"
               Text="End"
               FontAttributes="Italic"
               VerticalTextAlignment="Center"/>

        <TimePicker Grid.Row="2" Grid.Column="1"
                    x:Name="EndPicker"
                    Format="HH:mm"/>

        <!-- Done -->
        <Button Grid.Row="3" Grid.ColumnSpan="2"
                Margin="0,18,0,0"
                Text="Done"
                Clicked="OnDoneClicked"/>
    </Grid>
</ContentPage>