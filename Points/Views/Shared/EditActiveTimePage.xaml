<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Points.Views.Shared.EditActiveTimePage"
    Title="Active Time Log">

    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="12">

        <CollectionView
            Grid.Row="0"
            ItemsSource="{Binding Rows}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Grid Padding="24">
                    <Label Text="No time blocks yet. Activate this card to create active time."
                           TextColor="Gray"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Grid>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        ColumnDefinitions="*,*,60,44"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="10"
                        Padding="0,6"
                        VerticalOptions="Center">

                        <!-- Start cell -->
                        <Frame
                            Grid.Column="0"
                            Padding="12"
                            CornerRadius="12"
                            HasShadow="False"
                            BorderColor="{AppThemeBinding Light=#DDDDDD, Dark=#333333}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.EditStartCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <Label
                                Text="{Binding StartText}"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                LineBreakMode="NoWrap"/>
                        </Frame>

                        <!-- End cell -->
                        <Frame
                            Grid.Column="1"
                            Padding="12"
                            CornerRadius="12"
                            HasShadow="False"
                            BorderColor="{AppThemeBinding Light=#DDDDDD, Dark=#333333}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.EditEndCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <Label
                                Text="{Binding EndText}"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                LineBreakMode="NoWrap"/>
                        </Frame>

                        <!-- Hours (e.g. 0.0h) -->
                        <Label
                            Grid.Column="2"
                            Text="{Binding HoursText}"
                            VerticalOptions="Center"
                            HorizontalTextAlignment="End"
                            LineBreakMode="NoWrap" />

                        <!-- Delete ("X") -->
                        <Button
                            Grid.Column="3"
                            Grid.Row="0"
                            Text="✕"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            Padding="0"
                            FontAttributes="Bold"
                            BackgroundColor="{AppThemeBinding Light=#CC3333, Dark=#AA2222}"
                            TextColor="White"
                            Command="{Binding BindingContext.DeleteRowCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            CommandParameter="{Binding .}" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Text="{Binding MetadataSummary}"
                            IsVisible="{Binding HasMetadata}"
                            FontSize="12"
                            Opacity="0.72"
                            Margin="4,2,0,0" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="1"
            Text="Save"
            BackgroundColor="Green"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="21"
            HeightRequest="48"
            CornerRadius="12"
            Command="{Binding SaveCommand}" />
    </Grid>
</ContentPage>
