<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:Points.Views.Shared"
             x:Class="Points.Views.Shared.DateRangePickerPage"
             Title="DateRangePickerPage">
    
    <Grid RowDefinitions="*,Auto"
          Padding="12">

        <!-- Picker -->
        <shared:DateRangePickerView x:Name="RangePicker"
                                    Grid.Row="0"/>

        <!-- Save -->
        <Button Grid.Row="1"
                Text="Save"
                HeightRequest="48"
                Clicked="OnSaveClicked"/>
    </Grid>
    
</ContentPage>