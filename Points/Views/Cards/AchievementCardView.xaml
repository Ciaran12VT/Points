<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Points.Views.Cards.AchievementCardView">

    <Frame Margin="12,8"
           Padding="12"
           CornerRadius="12"
           HasShadow="True"
           BackgroundColor="{Binding CardBackgroundColor}"
           Opacity="{Binding CardOpacity}">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,Auto, Auto"
              RowSpacing="6">

            <!-- Row 1: Title -->
            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding Title}"
                   TextColor="{Binding CardForeColor}"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Label Grid.Row="0" Grid.Column="1"
                        Text="🔒"
                        IsVisible="{Binding IsLockedThisRange}"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        Margin="0,0,0,0" />
            
            <Label Grid.Row="0" Grid.Column="1"
                       Text="✓"
                       FontSize="18"
                       FontAttributes="Bold"
                       IsVisible="{Binding IsCompleted}"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Margin="0,0,0,0"
                       TextColor="LightGreen" />
            
            <Label Grid.Row="0" Grid.Column="1"
                       Text="✕"
                       FontSize="18"
                       FontAttributes="Bold"
                       IsVisible="{Binding IsFailed}"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Margin="0,0,0,0"
                       TextColor="IndianRed" />

            <Border
                    Grid.Row="0" Grid.Column="2" 
                    BackgroundColor="{Binding CardBadgeBackColor}"
                    StrokeShape="RoundRectangle 10"
                    Padding="8,4"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0"
                    Grid.RowSpan="6">

                <Label
                        Text="{Binding Difficulty}"
                        TextColor="{Binding CardBadgeForeColor}"
                        FontSize="12"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
            </Border>



            <!-- Row 2: Status + Tags -->
            <Label Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2"
                   Text="{Binding StatusDisplay, StringFormat='Status: {0}'}"
                   FontSize="13"
                   TextColor="Gray" />

            <Label Grid.Row="1" Grid.Column="2"
                   Text="{Binding SecondaryDescriptorText}"
                   FontSize="13"
                   TextColor="Gray"
                   HorizontalTextAlignment="End" />

            <!-- Row 2: LockProgressBar -->
            <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                         HeightRequest="18"
                         ProgressColor="Green"
                         IsVisible="{Binding IsLockedThisRange}"
                         Progress="{Binding LockProgress}" />

            <!-- Row 3: ProgressBar -->
            <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                         HeightRequest="18"
                         Progress="{Binding Progress}" />

            <!-- Row 4: Active Time (L) + Target Type (R) -->
            <Label Grid.Row="4" Grid.Column="0"
                   Text="{Binding ActiveTimeText}"
                   FontSize="14"
                   IsVisible="{Binding IsActiveTimeTextVisible}"
                   TextColor="Orange" />

            <!-- Row 5: Current Value (L) + Target (R) -->
            <Label Grid.Row="4" Grid.Column="0"
                   Text="{Binding CurrentValueText}"
                   TextColor="{Binding CardForeColor}"
                   IsVisible="{Binding IsCurrentValueTextVisible}"
                   FontSize="14" />

            <Label Grid.Row="4" Grid.Column="2"
                   Text="{Binding TargetText}"
                   FontSize="14"
                   TextColor="{Binding CardForeColor}"
                   HorizontalTextAlignment="End" />

            <!-- Row 6: Completion Time -->
            <Label Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{Binding CompletionTimeText}"
                   FontSize="13"
                   TextColor="Gray" />

        </Grid>

        <Frame.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenAchievementDetailsCommand}"
                CommandParameter="{Binding .}" />
        </Frame.GestureRecognizers>


    </Frame>
</ContentView>
