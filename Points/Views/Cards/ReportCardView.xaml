<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Points.Views.Cards.ReportCardView">

    <Frame Padding="12"
           CornerRadius="12"
           HasShadow="True"
           BorderColor="{AppThemeBinding Light=#DDDDDD, Dark=#333333}"
           BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

        <Grid RowDefinitions="Auto" ColumnDefinitions="*">
            <Label Text="{Binding Title}"
                   FontSize="16"
                   LineBreakMode="TailTruncation" />
        </Grid>

        <Frame.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenReportCommand}"
                CommandParameter="{Binding .}" />
        </Frame.GestureRecognizers>

    </Frame>

</ContentView>
