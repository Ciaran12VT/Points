<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Points.Views.Cards.TrackerCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Frame
        Padding="14"
        CornerRadius="18"
        HasShadow="True">

        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">

            <!-- Title row with Add button -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

                <Label
                    Grid.Column="0"
                    Text="{Binding Source={x:Reference Root}, Path=Title}"
                    FontAttributes="Bold"
                    FontSize="18"
                    LineBreakMode="TailTruncation"
                    VerticalTextAlignment="Center" />

                            <Button
                    Grid.Column="1"
                    Text="+"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    Margin="0"
                    TextColor="White"
                    BackgroundColor="Green"
                    Command="{Binding Source={x:Reference Root}, Path=AddValueCommand}"
                    CommandParameter="{Binding .}"/>

            </Grid>


            <!-- Sparkline -->
            <GraphicsView
                x:Name="SparklineView"
                Grid.Row="1"
                HeightRequest="64" />

            <!-- Footer -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <VerticalStackLayout Spacing="2">
                    <Label
                        Text="{Binding Source={x:Reference Root}, Path=AverageText}"
                        FontSize="13"
                        Opacity="0.85" />

                    <Label
                        Text="{Binding Source={x:Reference Root}, Path=PeriodText}"
                        FontSize="12"
                        Opacity="0.65" />
                </VerticalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="6"
                    VerticalOptions="Center"
                    HorizontalOptions="End">

                    <Label
                        Text="{Binding Source={x:Reference Root}, Path=LatestValueText}"
                        FontSize="15"
                        FontAttributes="Bold"
                        VerticalTextAlignment="Center"
                        Opacity="0.9" />

                    <Label
                        Text="{Binding Source={x:Reference Root}, Path=TrendArrow}"
                        FontSize="22"
                        FontAttributes="Bold"
                        VerticalTextAlignment="Center"
                        Opacity="0.9" />

                </HorizontalStackLayout>


            </Grid>

        </Grid>

        <Frame.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Frame.GestureRecognizers>

    </Frame>
</ContentView>
