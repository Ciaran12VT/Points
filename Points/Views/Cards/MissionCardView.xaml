<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Points.Converters;assembly=Points"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Points.Views.Cards.MissionCardView">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:MissionCurrentValueTextConverter x:Key="MissionCurrentValueTextConverter" />
            <converters:MissionCurrentValueColorConverter x:Key="MissionCurrentValueColorConverter" />
            <converters:ActiveTimeTextConverter x:Key="ActiveTimeTextConverter" />
            <converters:ActiveButtonBackgroundConverter x:Key="ActiveButtonBgConverter" />
            <converters:ActiveVsEstimatePercentTextConverter x:Key="ActiveVsEstimatePercentTextConverter" />
            <converters:ActiveVsEstimatePercentColorConverter x:Key="ActiveVsEstimatePercentColorConverter" />
            <converters:MissionDueInTextConverter x:Key="MissionDueInTextConverter" />
            <converters:MissionDueInColorConverter x:Key="MissionDueInColorConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Frame x:Name="RootFrame" Margin="12,8" Padding="12,12,8,12" CornerRadius="12" HasShadow="True">

        <Frame.Triggers>
            <!-- Grey out when complete -->
            <DataTrigger TargetType="Frame" Binding="{Binding IsComplete}" Value="True">
                <Setter Property="Opacity" Value="0.55" />
            </DataTrigger>

            <!-- Grey out when not available yet -->
            <DataTrigger TargetType="Frame" Binding="{Binding IsAvailable}" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </DataTrigger>

            <!-- Grey out when failed -->
            <DataTrigger TargetType="Frame" Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Opacity" Value="0.55" />
            </DataTrigger>

        </Frame.Triggers>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="6">

            <Grid.Triggers>
                <!-- Disable when complete -->
                <DataTrigger TargetType="Grid" Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>

                <!-- Disable when not available -->
                <DataTrigger TargetType="Grid" Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>

                <!-- Disable when failed -->
                <DataTrigger TargetType="Grid" Binding="{Binding IsFailed}" Value="True"> 
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>

            </Grid.Triggers>

            <!-- Row 0: Title -->
            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontSize="16" VerticalOptions="Center" />

            <!-- Row 0: Completion button (top-right) -->
            <Grid Grid.Row="0" Grid.Column="1" HorizontalOptions="End">

                <!-- Row 0: Action buttons (top-right) -->
                <HorizontalStackLayout
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="6"
                    HorizontalOptions="End"
                    VerticalOptions="Center">

                    <!-- New blue button -->
                    <Button Text="●"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        Margin="0"
                        TextColor="White"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ActivateCardCommand}"
                        CommandParameter="{Binding .}">
                        <Button.BackgroundColor>
                            <MultiBinding Converter="{StaticResource ActiveButtonBgConverter}">
                                <Binding Path="IsActive" />
                                <Binding Path="ValuePerMinute" />
                            </MultiBinding>
                        </Button.BackgroundColor>
                    </Button>

                    <!-- Existing completion button -->
                    <Button
                        Text="✓"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        Margin="0"
                        TextColor="White"
                        BackgroundColor="Green"
                        VerticalOptions="Center"
                        Clicked="OnCompleteClicked">

                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsComplete}" Value="True">
                                <Setter Property="BackgroundColor" Value="Gray" />
                                <Setter Property="Text" Value="✓" />
                            </DataTrigger>
                        </Button.Triggers>

                    </Button>

                </HorizontalStackLayout>


            </Grid>

            <!-- Row 1: Status (left, grey) -->
            <Label Grid.Row="1" Grid.Column="0" Text="{Binding StatusDisplay, StringFormat='Status: {0}'}" FontSize="13" TextColor="Gray" />

            <!-- Row 1: Status + Pending Window -->
            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">

                <Label
                    Text="{Binding StatusDisplay, StringFormat='Status: {0}'}"
                    FontSize="13"
                    TextColor="Gray" />

                <Label
                    Text="{Binding PendingWindowText}"
                    FontSize="12"
                    TextColor="White"
                    IsVisible="{Binding IsPending}" />

            </VerticalStackLayout>


            <!-- Row 1: Tags (right, grey) -->
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Tags, StringFormat='Tags: {0}'}" FontSize="13" TextColor="Gray" HorizontalTextAlignment="End" />

            <!-- Row 2: SubType +Time summary -->
            <HorizontalStackLayout
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="1"
                Spacing="6"
                HorizontalOptions="Start">

                <Label Grid.Row="2" Grid.Column="0" Text="{Binding SubType}" FontSize="14" TextColor="{Binding SubTypeLabelColor}" />
                <Label Grid.Row="2" Grid.Column="0" Text=" - " FontSize="14" TextColor="Orange" />
                <Label FontSize="14" TextColor="Orange" >
                    <Label.Text>
                        <MultiBinding Converter="{StaticResource ActiveTimeTextConverter}">
                            <!-- the card itself -->
                            <Binding Path="." />
                            <!-- window start/end from HomeViewModel -->
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.RangeStart" />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.RangeEnd" />
                            <!-- force refresh every second -->
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
                <Label Text="/" FontSize="14" TextColor="Gray" />
                <Label Text="{Binding EstCompletionTimeText}" FontSize="14" TextColor="LightBlue" />
                <Label FontSize="14">
                    <Label.Text>
                        <MultiBinding Converter="{StaticResource ActiveVsEstimatePercentTextConverter}">
                            <!-- card -->
                            <Binding Path="." />
                            <!-- window -->
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.RangeStart" />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.RangeEnd" />
                            <!-- tick -->
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                        </MultiBinding>
                    </Label.Text>

                    <Label.TextColor>
                        <MultiBinding Converter="{StaticResource ActiveVsEstimatePercentColorConverter}">
                            <Binding Path="." />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.RangeStart" />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.RangeEnd" />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                        </MultiBinding>
                    </Label.TextColor>
                </Label>



            </HorizontalStackLayout>

            <!-- Row 2: Value (right, green) -->
            
            <Label Grid.Row="2" Grid.Column="1" FontSize="14" HorizontalTextAlignment="End">
                <Label.Text>
                    <MultiBinding Converter="{StaticResource MissionCurrentValueTextConverter}">
                        <!-- the card -->
                        <Binding Path="." />
                        <!-- current time -->
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                    </MultiBinding>
                </Label.Text>
                <Label.TextColor>
                    <MultiBinding Converter="{StaticResource MissionCurrentValueColorConverter}">
                        <Binding Path="." />
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                    </MultiBinding>
                </Label.TextColor>
            </Label>

            <HorizontalStackLayout
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Spacing="6"
                HorizontalOptions="Start">

                <Label Grid.Row="3" Grid.Column="0" FontSize="14" HorizontalTextAlignment="Start" Text="Due in:" />
                <Label Grid.Row="3" Grid.Column="0" FontSize="14" HorizontalTextAlignment="End" IsVisible="{Binding IsAvailable}">
                    <Label.Text>
                        <MultiBinding Converter="{StaticResource MissionDueInTextConverter}">
                            <!-- the card -->
                            <Binding Path="." />
                            <!-- current time -->
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                        </MultiBinding>
                    </Label.Text>
                    <Label.TextColor>
                        <MultiBinding Converter="{StaticResource MissionDueInColorConverter}">
                            <Binding Path="." />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                        </MultiBinding>
                    </Label.TextColor>
                </Label>



            </HorizontalStackLayout>

        </Grid>

        <Frame.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Frame.GestureRecognizers>

    </Frame>
</ContentView>
