<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Points.Converters;assembly=Points"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Points.Views.Cards.TatCardView">

    <Frame Margin="12,8"
           Padding="12"
           CornerRadius="12"
           HasShadow="True">

        <Grid RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="*,Auto"
              RowSpacing="6">

            <!-- Row 0: Title (top-left) -->
            <Label Grid.Row="0" Grid.Column="0"
                   Text="{Binding Title}"      
                   FontSize="16"
                   VerticalOptions="Center">
                <Label.TextColor>
                    <MultiBinding Converter="{StaticResource LockTitleColorConverter}">
                        <Binding Path="TextColor" />
                        <Binding Path="." />
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.ActiveCardsForLocks" />
                    </MultiBinding>
                </Label.TextColor>
            </Label>

            <!-- Row 0: Activity toggle (top-right) -->
            <HorizontalStackLayout Grid.Row="0"
                  Grid.Column="1"
                  HorizontalOptions="End">

                <Label Text="🔒"
                       VerticalOptions="Center"
                       Margin="0,0,6,0">
                    <Label.IsVisible>
                        <MultiBinding Converter="{StaticResource IsLockedNowConverter}">
                            <Binding Path="." />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.ActiveCardsForLocks" />
                        </MultiBinding>
                    </Label.IsVisible>
                </Label>

                <Label Text="{Binding SelectedRateName}" VerticalOptions="Center" HorizontalOptions="Start" Margin="9" TextColor="Yellow" IsVisible="{Binding ShowRateNameOnCard}"/>

                <Button Text="●"
                    x:Name="ActivityToggleButton"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    Margin="0"
                    TextColor="White"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ActivateCardCommand}"
                    CommandParameter="{Binding .}"
                    Pressed="ActivityToggleButton_Pressed"
                    Released="ActivityToggleButton_Released"
                    Unfocused="ActivityToggleButton_Released">
                    <!--<Button.Behaviors>
                        <toolkit:TouchBehavior
                            LongPressDuration="600"
                            BindingContext="{Binding Source={x:Reference ActivityToggleButton}, Path=BindingContext}"
                            LongPressCommand="{Binding LongPressCommand}"/>
                    </Button.Behaviors>-->
                    <Button.BackgroundColor>
                        <MultiBinding Converter="{StaticResource ActiveButtonBgConverter}">
                            <Binding Path="IsActive" />
                            <Binding Path="ValuePerMinute" />
                        </MultiBinding>
                    </Button.BackgroundColor>
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource NotLockedConverter}">
                            <Binding Path="." />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.ActiveCardsForLocks" />
                        </MultiBinding>
                    </Button.IsEnabled>
                    <Button.Opacity>
                        <MultiBinding Converter="{StaticResource LockedToOpacityConverter}">
                            <Binding Path="." />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                            <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.ActiveCardsForLocks" />
                        </MultiBinding>
                    </Button.Opacity>
                </Button>


            </HorizontalStackLayout>

            <!-- Row 1: Status (left, grey) -->
            <Label Grid.Row="1" Grid.Column="0"
                   FontSize="13"
                   IsVisible="{Binding ShowStatusLabel}"
                   TextColor="Gray">
                <Label.Text>
                    <MultiBinding Converter="{StaticResource LockStatusTextConverter}">
                        <Binding Path="." />
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.ActiveCardsForLocks" />
                    </MultiBinding>
                </Label.Text>
            </Label>
            
            <!-- Row 1: Tags (right, grey) -->
            <Label Grid.Row="1" Grid.Column="1"
               Text="{Binding Tags, StringFormat='Tags: {0}'}"
               FontSize="13"
               TextColor="Gray"
               HorizontalTextAlignment="End" />
            
            <!-- Row 2: Active Time (left, orange) -->
            <Label Grid.Row="2" Grid.Column="0"
               FontSize="14"
               TextColor="Orange">
                <Label.Text>
                    <MultiBinding Converter="{StaticResource ActiveTimeTextConverter}">
                        <!-- the card itself -->
                        <Binding Path="." />
                        <!-- window start/end from HomeViewModel -->
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.RangeStart" />
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.RangeEnd" />
                        <!-- force refresh every second -->
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                    </MultiBinding>
                </Label.Text>
            </Label>

            <!-- Row 2: Value (right, green) -->
            <Label Grid.Row="2" Grid.Column="1"
               FontSize="14"
               HorizontalTextAlignment="End"
               TextColor="{Binding ValuePerMinute, Converter={StaticResource ValueColorConverter}}">
                <Label.Text>
                    <MultiBinding Converter="{StaticResource ValueTextConverter}">
                        <Binding Path="." />
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.RangeStart" />
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.RangeEnd" />
                        <!-- force refresh every second -->
                        <Binding Source="{RelativeSource AncestorType={x:Type ContentPage}}" Path="BindingContext.Now" />
                    </MultiBinding>
                </Label.Text>
            </Label>
            

        </Grid>

        <Frame.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCardDetailsCommand}"
                CommandParameter="{Binding .}" />
        </Frame.GestureRecognizers>

    </Frame>

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:ActiveTimeTextConverter x:Key="ActiveTimeTextConverter" />
            <converters:ValueTextConverter x:Key="ValueTextConverter" />
            <converters:ValuePerMinuteToValueColorConverter x:Key="ValueColorConverter" />
            <converters:ActiveButtonBackgroundConverter x:Key="ActiveButtonBgConverter" />
            <converters:IsLockedNowConverter x:Key="IsLockedNowConverter" />
            <converters:LockStatusTextConverter x:Key="LockStatusTextConverter" />
            <converters:LockTitleColorConverter x:Key="LockTitleColorConverter" />
            <converters:NotLockedConverter x:Key="NotLockedConverter" />
            <converters:LockedToOpacityConverter x:Key="LockedToOpacityConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

</ContentView>
