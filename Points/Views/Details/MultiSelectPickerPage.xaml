<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Points.Views.Details.MultiSelectPickerPage"
             Title="{Binding TitleText}">

    <Grid RowDefinitions="*,Auto,Auto" Padding="12" RowSpacing="10">

        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="0,6" CornerRadius="10" HasShadow="True">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding .}" VerticalOptions="Center"/>

                            <Button Grid.Column="1"
                                    Text="+"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    CornerRadius="18"
                                    Padding="0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Selected preview + clear -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Entry Text="{Binding SelectedText}"
                   IsReadOnly="True"
                   Placeholder="Selected..."
                   VerticalOptions="Center"/>

            <Button Grid.Column="1"
                    Text="Clear"
                    Command="{Binding ClearCommand}"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- OK / Cancel -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="Cancel"
                    Clicked="OnCancelClicked"/>

            <Button Grid.Column="1"
                    Text="OK"
                    BackgroundColor="Green"
                    TextColor="White"
                    Clicked="OnOkClicked"/>
        </Grid>

    </Grid>
</ContentPage>
