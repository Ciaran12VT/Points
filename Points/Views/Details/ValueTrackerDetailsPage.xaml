<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Points.Views.Details.ValueTrackerDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Value Tracker">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Title -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <Label Text="Title"
                       FontAttributes="Bold"
                       FontSize="14"
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Text="X"
                        BackgroundColor="DarkRed"
                        TextColor="White"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Clicked="OnDeleteClicked" />
            </Grid>

            <Entry x:Name="TitleEntry"
                   Placeholder="e.g. Body Weight"
                   Text="{Binding Title}" />

            <!-- Unit -->
            <Label Text="Unit" FontAttributes="Bold" FontSize="14" />
            <Entry x:Name="UnitEntry"
                   Placeholder="e.g. kg, €, bpm"
                   Text="{Binding Unit}" />

            <!-- Start Date -->
            <Label Text="Start date" FontAttributes="Bold" FontSize="14" />
            <DatePicker x:Name="StartDatePicker"
                        Date="{Binding StartDate}"
                        HorizontalOptions="Fill" />

            <!-- Initial Values -->
            <Label Text="Initial values (optional)" FontAttributes="Bold" FontSize="14" />
            <Label Text="Comma separated (e.g. 72.4, 72.1, 71.9)"
                   FontSize="12"
                   Opacity="0.65" />
            <Editor x:Name="ValuesEditor"
                    AutoSize="TextChanges"
                    HeightRequest="90"
                    Placeholder="72.4, 72.1, 71.9" />

            <!-- Schedule -->
            <!--<Label Text="Schedule (record only for now)" FontAttributes="Bold" FontSize="14" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Label Text="Every" VerticalTextAlignment="Center" />

                <Entry x:Name="EveryEntry"
                       Grid.Column="1"
                       Text="1"
                       Keyboard="Numeric"
                       HorizontalTextAlignment="Center" />

                <Picker x:Name="UnitPicker"
                        Grid.Column="2"
                        WidthRequest="140" />

                <Label Grid.Column="3"
                       Text="from start date"
                       VerticalTextAlignment="Center"
                       Opacity="0.7" />
            </Grid>-->
            <Label Text="Schedule" FontAttributes="Bold" FontSize="14" />

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Center">

                <Label x:Name="ScheduleSummaryLabel"
                       Text="None"
                       Opacity="0.75"
                       VerticalTextAlignment="Center" />

                <Button Grid.Column="1"
                        Text="📅"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        BackgroundColor="Green"
                        Clicked="OnEditSchedulesClicked" />
            </Grid>

            <Button Text="Metadata Fields"
                    TextColor="White"
                    BackgroundColor="DodgerBlue"
                    CornerRadius="12"
                    Clicked="OnEditUdmdClicked" />

            <Label x:Name="MetadataHistoryTitle"
                   Text="Recorded Metadata"
                   FontAttributes="Bold"
                   FontSize="14"
                   IsVisible="False" />
            <VerticalStackLayout x:Name="MetadataHistoryStack"
                                 Spacing="6"
                                 IsVisible="False" />


            <!-- Error -->
            <Label x:Name="ErrorLabel"
                   Text=""
                   TextColor="OrangeRed"
                   IsVisible="False" />

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Text="Cancel"
                        BackgroundColor="Gray"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="21"
                        HeightRequest="48"
                        CornerRadius="12"
                        Clicked="OnCancelClicked" />

                <Button Grid.Column="1"
                        Text="OK"
                        BackgroundColor="Green"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="21"
                        HeightRequest="48"
                        CornerRadius="12"
                        Clicked="OnOkClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
