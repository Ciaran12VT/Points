<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Points.Views.Details.DurationPickerPage"
             Title="Set Active Time Target">

    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">

        <Label Text="Enter a duration" FontAttributes="Bold" FontSize="18" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Label Text="Hours" VerticalOptions="Center"/>
            <Entry x:Name="HoursEntry" Grid.Column="1" Keyboard="Numeric" Placeholder="0" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Label Text="Minutes" VerticalOptions="Center"/>
            <Entry x:Name="MinutesEntry" Grid.Column="1" Keyboard="Numeric" Placeholder="0" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Label Text="Seconds" VerticalOptions="Center"/>
            <Entry x:Name="SecondsEntry" Grid.Column="1" Keyboard="Numeric" Placeholder="0" />
        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Button Text="Cancel" 
            Clicked="OnCancelClicked" 
            FontAttributes="Bold"
            TextColor="White"
            BackgroundColor="Red" />

            <Button Grid.Column="1"
            Text="Reset"
            Clicked="OnResetClicked"
            FontAttributes="Bold"
            TextColor="White"
            BackgroundColor="Gray" />

            <Button Grid.Column="2" 
            Text="OK" 
            BackgroundColor="Green" 
            TextColor="White" 
            Clicked="OnOkClicked" 
            FontAttributes="Bold"/>
        </Grid>


    </Grid>
</ContentPage>
