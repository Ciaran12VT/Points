<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Points.Views.Details.TatDetailsPage"
             Title="TAT Details">

    <Grid RowDefinitions="*,Auto" Padding="12">

        <!-- Scrollable content -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="14">

                <!-- Title + Entry + Cancel (single row) -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Title"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>

                    <Entry Grid.Column="1"
                           Text="{Binding Title}"
                           Placeholder="Enter title"
                           VerticalOptions="Center"/>

                    <Button Grid.Column="2"
                            Text="✕"
                            BackgroundColor="DarkRed"
                            TextColor="White"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Command="{Binding CancelCommand}"/>
                </Grid>

                <!-- Status (single row, read-only) -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Status"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{Binding Status}"
                           TextColor="Gray"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Tags (single row) -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Tags"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Entry Grid.Column="1" x:Name="TagsEntry"
                           Text="{Binding Tags}"
                           IsReadOnly="True"
                           Placeholder="e.g. PRO TAT Other"
                           VerticalOptions="Center"/>
                     <!--Edit--> 
                    <Button Grid.Column="2"
                        Text="✎"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        Margin="0"
                        TextColor="White"
                        BackgroundColor="Black"
                        Clicked="OnEditTagsClicked"
                        VerticalOptions="Center"/>

                    <!-- Clear -->
                    <Button Grid.Column="3"
                        Text="⌫"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        Margin="0"
                        TextColor="White"
                        BackgroundColor="DarkRed"
                        Clicked="OnClearTagsClicked"
                        VerticalOptions="Center"/>
                </Grid>

                <!-- Value per minute (single row, with inline button) -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Value Per Minute"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Entry Grid.Column="1"
                           Keyboard="Numeric"
                           Text="{Binding ValuePerMinuteText}"
                           TextColor="{Binding SignToggleColor}"
                           Placeholder="e.g. 1.25"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="2"
                            Text="{Binding SignToggleText}"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            FontAttributes="Bold"
                            Padding="0"
                            HorizontalOptions="End"
                            TextColor="White"
                            BackgroundColor="{Binding SignToggleColor}"
                            Command="{Binding ToggleSignCommand}"
                            VerticalOptions="Center"/>
                </Grid>

                <!-- Current accrued value (single row, read-only) -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Current Accrued Value"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{Binding CurrentAccruedValueText}"
                           TextColor="{Binding SignToggleColor}"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Active Time (single row, with inline buttons) -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Active Time"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>

                    <Label Grid.Column="1"
                           Text="{Binding ActiveTimeText}"
                           TextColor="Orange"
                           VerticalOptions="Center"/>

                    <!-- Clock -->
                    <Button Grid.Column="2"
                            Text="⏱"
                            BackgroundColor="Black"
                            TextColor="{Binding ActiveTimeTargetLabelColor}"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Clicked="OnSetActiveTimeTargetClicked"/>

                    <!-- Edit -->
                    <Button Grid.Column="3"
                            Text="✎"
                            BackgroundColor="Black"
                            TextColor="White"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Clicked="OnEditActiveTimeClicked"/>
                </Grid>

                <!-- Description (EXCEPTION: label + editor remain stacked) -->
                <Label Text="Description" FontAttributes="Bold"/>
                <Editor AutoSize="TextChanges"
                        Text="{Binding Description}"
                        Placeholder="Optional notes..."
                        HeightRequest="400"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save button pinned to bottom -->
        <Button Grid.Row="1"
                Text="Save"
                BackgroundColor="Green"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="21"
                Command="{Binding SaveCommand}"
                HeightRequest="48"/>

    </Grid>
</ContentPage>
