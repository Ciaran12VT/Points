<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Points.Views.Details.BudgetDetailsPage"
             Title="Budget Details">

    <Grid RowDefinitions="*,Auto" Padding="12">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="14">


                <!-- Title + Cancel -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">

                    <Label Text="Title" FontAttributes="Bold" VerticalOptions="Center"/>

                    <Button Grid.Column="1"
                            Text="×"
                            BackgroundColor="DarkRed"
                            TextColor="White"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            FontAttributes="Bold"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Command="{Binding CancelCommand}"
/>
                </Grid>
                <Entry Text="{Binding Title}" Placeholder="Enter title" x:Name="TitleEntry"/>

                <!-- Status (read-only) -->
                <Label Text="Status" FontAttributes="Bold"/>
                <Label Text="{Binding Status}" TextColor="Gray"/>

                <!-- Tags -->
                <Label Text="Tags" FontAttributes="Bold"/>
                <Entry Text="{Binding Tags}" Placeholder="e.g. PRO Budget Other"/>

                <!-- Currency -->
                <Label Text="Currency" FontAttributes="Bold"/>
                <Entry Text="{Binding Currency}" Placeholder="e.g. Kcal"/>

                <!-- Exchange Rate (up to 3 decimals) -->
                <Label Text="Exchange Rate" FontAttributes="Bold"/>
                <Entry Text="{Binding ExchangeRateText}"
                       Keyboard="Numeric"
                       Placeholder="e.g. 0.010" />

                <!-- Scheduled Top-Ups -->
                <Label Text="Scheduled Top-Ups" FontAttributes="Bold"/>

                <CollectionView ItemsSource="{Binding TopUps}"
                                SelectionMode="None"
                                Margin="0,4,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10"
                                   Margin="0,6"
                                   CornerRadius="10"
                                   HasShadow="True">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="10"
                                      RowSpacing="8">

                                    <!-- Amount -->
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                        <Label Text="Amount" FontSize="13" TextColor="Gray"/>
                                        <Entry Text="{Binding AmountText}"
                                               Keyboard="Numeric"
                                               Placeholder="e.g. 500" />
                                    </VerticalStackLayout>

                                    <!-- Remove -->
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Text="✕"
                                            TextColor="White"
                                            BackgroundColor="DarkRed"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            CornerRadius="8"
                                            Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveTopUpCommand}"
                                            CommandParameter="{Binding .}" />

                                    <!-- Time -->
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                        <Label Text="Time" FontSize="13" TextColor="Gray"/>
                                        <TimePicker Time="{Binding TimeOfDay}" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Add Top-Up"
                        Command="{Binding AddTopUpCommand}"
                        TextColor="White"
                        BackgroundColor="Green"
                        Margin="0,8,0,0"/>

                <Button Text="Transaction Log"
                        Command="{Binding OpenTransactionLogCommand}"
                        TextColor="White"
                        BackgroundColor="DodgerBlue"
                        Margin="0,8,0,0"/>

                <!-- Start Date/Time -->
                <Label Text="Start Date" FontAttributes="Bold"/>
                <DatePicker Date="{Binding StartDate}" />
                <TimePicker Time="{Binding StartTime}" />

                <!-- Balance -->
                <Label Text="Balance" FontAttributes="Bold"/>
                <Entry Text="{Binding InitialBalanceText}"
                       Keyboard="Numeric"
                       Placeholder="0" />

                <!-- Description -->
                <Label Text="Description" FontAttributes="Bold"/>
                <Editor AutoSize="TextChanges"
                        Text="{Binding Description}"
                        Placeholder="Optional notes..."
                        HeightRequest="120"/>

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                Text="Save"
                BackgroundColor="Green"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="21"
                Command="{Binding SaveCommand}"
                HeightRequest="48"/>
    </Grid>
</ContentPage>
