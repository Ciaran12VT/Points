<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Points.Models"
             x:Class="Points.Views.Details.AchievementDetailsPage"
             Title="Achievement Details">

    <Grid RowDefinitions="*,Auto" Padding="12" Margin="0,0,0,24">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="14">

                <!-- Title -->
                <Label Text="Title" FontAttributes="Bold"/>
                <Entry Text="{Binding Title}" Placeholder="Enter title"/>

                <!-- Status (read-only) -->
                <Label Text="Status" FontAttributes="Bold"/>
                <Label Text="{Binding Status}" TextColor="Gray"/>

                <!-- Tags -->
                <Label Text="Tags" FontAttributes="Bold"/>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                    <!-- Read-only display -->
                    <Entry x:Name="TagsEntry"
                       Text="{Binding Tags}"
                       IsReadOnly="True"
                       Placeholder="Tap edit to select tags"
                       VerticalOptions="Center"/>

                    <!-- Edit -->
                    <Button Grid.Column="1"
                        Text="✎"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        Margin="0"
                        TextColor="White"
                        BackgroundColor="Black"
                        Clicked="OnEditTagsClicked"
                        VerticalOptions="Center"/>

                    <!-- Clear -->
                    <Button Grid.Column="2"
                        Text="✕"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        Margin="0"
                        TextColor="White"
                        BackgroundColor="DarkRed"
                        Clicked="OnClearTagsClicked"
                        VerticalOptions="Center"/>

                </Grid>


                <!-- Goal Type -->
                <Label Text="Goal Type" FontAttributes="Bold"/>
                <Picker x:Name="GoalTypePicker"
                    Title="Select goal type"
                    ItemsSource="{Binding GoalTypeOptions}"
                    SelectedItem="{Binding GoalType}" />

                <!-- Target for VALUE -->
                <VerticalStackLayout IsVisible="{Binding IsValueTargetVisible}">
                    <Label Text="Target Value" FontAttributes="Bold"/>
                    <Entry Text="{Binding TargetValueText}"
                       Keyboard="Numeric"
                       Placeholder="e.g. 100" />
                            </VerticalStackLayout>

                <!-- Target for ACTIVE TIME -->
                <VerticalStackLayout IsVisible="{Binding IsActiveTimeTargetVisible}">
                    <!-- Target (Active Time) -->
                    <Label Text="Target (Active Time)" FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <!-- Read-only display -->
                        <Entry x:Name="ActiveTimeTargetEntry"
                           Text="{Binding ActiveTimeTargetText}"
                           IsReadOnly="True"
                           Placeholder="hh:mm:ss"
                           VerticalOptions="Center"/>

                        <!-- Edit button -->
                        <Button Grid.Column="1"
                            Text="✎"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            Padding="0"
                            Margin="0"
                            TextColor="White"
                            BackgroundColor="Black"
                            Clicked="OnEditActiveTimeTargetClicked"
                            VerticalOptions="Center"/>
                    </Grid>


                </VerticalStackLayout>

                <!-- Target for Steps -->
                <VerticalStackLayout IsVisible="{Binding IsStepTargetVisible}">
                    <Label Text="Step" FontAttributes="Bold"/>
                    <Picker x:Name="StepPicker" Title="Select step" SelectedItem="{Binding StepName}" />
                    <Label Text="Target" FontAttributes="Bold"/>
                    <Entry Text="{Binding TargetValueText}"
                           Keyboard="Numeric"
                           Placeholder="e.g. 50" />
                </VerticalStackLayout>

                <!-- Target for Achievements -->
                <VerticalStackLayout IsVisible="{Binding IsAchievementTargetVisible}">
                    <Label Text="Achievements" FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <!-- Read-only display -->
                        <Entry x:Name="AchievementsEntry"
                               Text="{Binding AchievementTitle}"
                               IsReadOnly="True"
                               Placeholder="Tap edit to select"
                               VerticalOptions="Center"/>

                        <!-- Edit -->
                        <Button Grid.Column="1"
                                Text="✎"
                                WidthRequest="36"
                                HeightRequest="36"
                                CornerRadius="18"
                                Padding="0"
                                Margin="0"
                                TextColor="White"
                                BackgroundColor="Black"
                                Clicked="OnEditAchievementsClicked"
                                VerticalOptions="Center"/>

                        <!-- Clear -->
                        <Button Grid.Column="2"
                                Text="✕"
                                WidthRequest="36"
                                HeightRequest="36"
                                CornerRadius="18"
                                Padding="0"
                                Margin="0"
                                TextColor="White"
                                BackgroundColor="DarkRed"
                                Clicked="OnClearAchievementsClicked"
                                VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>


                <!-- Completion Type -->
                <Label Text="Completion Type" FontAttributes="Bold"/>
                <Picker x:Name="CompletionTypePicker"
                    Title="Select completion type"
                    SelectedItem="{Binding CompletionType}" />


                <!-- Range -->
                <VerticalStackLayout IsVisible="{Binding IsRangeVisible}">
                    <Label Text="Completion Range" FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Picker Grid.Column="0"
                            x:Name="RangeUnitPicker"
                            Title="Unit"
                            SelectedItem="{Binding RangeUnit}" />


                        <Entry Grid.Column="1"
                               WidthRequest="90"
                               Text="{Binding RangeAmountText}"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="End"
                               Placeholder="7" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Deadline -->
                <VerticalStackLayout IsVisible="{Binding IsDeadlineVisible}">
                    <Label Text="Deadline" FontAttributes="Bold"/>
                    <DatePicker Date="{Binding DeadlineDate}" />
                    <TimePicker Time="{Binding DeadlineTime}" />
                </VerticalStackLayout>

                <!-- Trophies -->
                <Label Text="Trophies" FontAttributes="Bold"/>

                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                    <!-- Add Photo -->
                    <Button Text="🖼"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    Margin="0"
                    TextColor="White"
                    BackgroundColor="Black"
                    Clicked="OnAddTrophyPhotoClicked"/>

                    <!-- Add File -->
                    <Button Grid.Column="1"
                    Text="📎"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    Margin="0"
                    TextColor="White"
                    BackgroundColor="Black"
                    Clicked="OnAddTrophyFileClicked"/>

                    <!-- Count -->
                    <Label Grid.Column="2"
                   Text="{Binding Model.TrophyCount, StringFormat='Available: {0}'}"
                   VerticalTextAlignment="Center"
                   TextColor="Gray"/>

                    <!-- Clear -->
                    <Button Grid.Column="3"
                    Text="✕"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    Margin="0"
                    TextColor="White"
                    BackgroundColor="DarkRed"
                    Clicked="OnClearTrophiesClicked"/>
                </Grid>



            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                Text="Save"
                Command="{Binding SaveCommand}"
                HeightRequest="48"/>
    </Grid>
</ContentPage>
