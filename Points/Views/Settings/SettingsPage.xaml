<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Points.Views.Settings.SettingsPage"
             x:Name="SettingsRoot"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <Frame Padding="0"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="#DDDDDD">

                <VerticalStackLayout Spacing="0">

                    <Button Text="Database"
                            Command="{Binding Source={x:Reference SettingsRoot}, Path=OpenDatabaseSettingsCommand}"
                            HorizontalOptions="Fill"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            FontAttributes="Bold"
                            HeightRequest="56" />

                    <BoxView HeightRequest="1"
                             Color="#DDDDDD" />

                    <Button Text="Multipliers"
                            Command="{Binding Source={x:Reference SettingsRoot}, Path=OpenMultipliersSettingsCommand}"
                            HorizontalOptions="Fill"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            FontAttributes="Bold"
                            HeightRequest="56" />

                    <BoxView HeightRequest="1"
                             Color="#DDDDDD" />

                    <Button Text="Modules &amp; Features"
                            Command="{Binding Source={x:Reference SettingsRoot}, Path=OpenModulesAndFeaturesSettingsCommand}"
                            HorizontalOptions="Fill"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            FontAttributes="Bold"
                            HeightRequest="56" />

                    <BoxView HeightRequest="1"
                             Color="#DDDDDD" />

                    <Button Text="Defaults and Misc"
                            Command="{Binding Source={x:Reference SettingsRoot}, Path=OpenDefaultsAndMiscSettingsCommand}"
                            HorizontalOptions="Fill"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            FontAttributes="Bold"
                            HeightRequest="56" />

                    <BoxView HeightRequest="1"
                             Color="#DDDDDD" />

                    <Button Text="Notifications Log"
                            Command="{Binding Source={x:Reference SettingsRoot}, Path=OpenNotificationsLogCommand}"
                            HorizontalOptions="Fill"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            FontAttributes="Bold"
                            HeightRequest="56" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
