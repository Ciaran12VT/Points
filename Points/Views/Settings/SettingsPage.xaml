<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Points.Views.Settings.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <!-- DATABASE -->
            <toolkit:Expander IsExpanded="True">
                <toolkit:Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" Padding="12">
                        <Label Text="Database" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding DatabaseSectionChevron}"
                               VerticalOptions="Center"
                               Opacity="0.6"/>
                    </Grid>
                </toolkit:Expander.Header>

                <toolkit:Expander.Content>
                    <VerticalStackLayout Padding="12" Spacing="10">

                        <Button Text="Wipe"
                                BackgroundColor="#B00020"
                                TextColor="White"
                                Command="{Binding WipeCommand}" />

                        <Button Text="Backup"
                                Command="{Binding BackupCommand}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="Last backed up:" VerticalOptions="Center" Opacity="0.7"/>
                            <Label Grid.Column="1"
                                   Text="{Binding LastBackedUpText}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Button Text="Restore"
                                Command="{Binding RestoreCommand}" />

                        <Button Text="Browse Backup Files"
                                Command="{Binding BrowseBackupsCommand}" />

                    </VerticalStackLayout>
                </toolkit:Expander.Content>
            </toolkit:Expander>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
