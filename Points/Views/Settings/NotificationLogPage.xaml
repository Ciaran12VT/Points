<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Points.ViewModels.Settings"
             x:Class="Points.Views.Settings.NotificationLogPage"
             x:Name="NotificationLogRoot"
             Title="Notifications Log">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="12">

        <Button Grid.Row="0"
                Text="Refresh"
                Command="{Binding RefreshCommand}"
                HeightRequest="44"
                HorizontalOptions="End" />

        <HorizontalStackLayout Grid.Row="1"
                               Spacing="8"
                               BindableLayout.ItemsSource="{Binding Tabs}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:NotificationLogTabViewModel">
                    <Frame Padding="14,8"
                           CornerRadius="18"
                           HasShadow="False"
                           BorderColor="{Binding BorderColor}"
                           BackgroundColor="{Binding BackgroundColor}">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.SelectTabCommand, Source={x:Reference NotificationLogRoot}}"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <HorizontalStackLayout Spacing="8"
                                               VerticalOptions="Center">
                            <Label Text="{Binding Title}"
                                   TextColor="{Binding TextColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center" />

                            <Frame WidthRequest="22"
                                   HeightRequest="22"
                                   CornerRadius="11"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding BadgeColor}"
                                   IsVisible="{Binding HasBadge}">
                                <Label Text="{Binding BadgeText}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Frame>
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Rows}"
                        SelectionMode="None"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="8" Spacing="6">
                    <Label Text="No notifications in this tab."
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <Grid Padding="0,10"
                      IsVisible="{Binding IsLoadingMore}">
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                       HorizontalOptions="Center" />
                </Grid>
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12"
                           Margin="0,0,0,10"
                           CornerRadius="8"
                           HasShadow="False"
                           BorderColor="{AppThemeBinding Light=#DDDDDD, Dark=#333333}">

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="8"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">

                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding TitleText}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />

                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding Status}"
                                   TextColor="{Binding StatusColor}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="End" />

                            <Label Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding NoteText}"
                                   IsVisible="{Binding HasNote}"
                                   FontSize="12"
                                   Opacity="0.75"
                                   LineBreakMode="TailTruncation" />

                            <Grid Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="6">

                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <Label Text="CreatedAt"
                                           FontSize="11"
                                           Opacity="0.65" />
                                    <Label Text="{Binding CreatedAtText}"
                                           FontSize="13"
                                           LineBreakMode="NoWrap" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <Label Text="ScheduledAt"
                                           FontSize="11"
                                           Opacity="0.65" />
                                    <Label Text="{Binding ScheduledAtText}"
                                           FontSize="13"
                                           LineBreakMode="NoWrap" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                    <Label Text="ScheduleFor"
                                           FontSize="11"
                                           Opacity="0.65" />
                                    <Label Text="{Binding ScheduleForText}"
                                           FontSize="13"
                                           LineBreakMode="NoWrap" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <Label Text="SentAt"
                                           FontSize="11"
                                           Opacity="0.65" />
                                    <Label Text="{Binding SentAtText}"
                                           FontSize="13"
                                           LineBreakMode="NoWrap" />
                                </VerticalStackLayout>

                            </Grid>

                            <Label Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding ErrorText}"
                                   IsVisible="{Binding HasError}"
                                   TextColor="#B00020"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation" />

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
