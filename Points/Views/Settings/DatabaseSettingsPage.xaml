<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Points.Views.Settings.DatabaseSettingsPage"
             Title="Database Settings">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <Frame Padding="12"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="#DDDDDD">

                <VerticalStackLayout Spacing="10">

                    <Button Text="Wipe"
                            BackgroundColor="#B00020"
                            TextColor="White"
                            Clicked="OnWipeDbClicked" />

                    <Button Text="Backup"
                            Command="{Binding BackupCommand}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="Last backed up:"
                               VerticalOptions="Center"
                               Opacity="0.7" />
                        <Label Grid.Column="1"
                               Text="{Binding LastBackedUpText}"
                               VerticalOptions="Center" />
                    </Grid>

                    <Button Text="Restore"
                            Command="{Binding RestoreCommand}" />

                    <Button Text="Browse Backup Files"
                            Command="{Binding BrowseBackupsCommand}" />

                    <Button Text="Export Database"
                            Clicked="OnExportDBClicked" />

                    <Button Text="Import Database"
                            Clicked="OnImportDBClicked" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>