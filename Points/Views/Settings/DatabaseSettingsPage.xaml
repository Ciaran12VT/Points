<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Points.Views.Settings.DatabaseSettingsPage"
             x:Name="DatabaseSettings"
             Title="Database Settings">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <Frame Padding="12"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="#DDDDDD">

                <VerticalStackLayout Spacing="10">

                    <Button Text="Wipe"
                            BackgroundColor="#B00020"
                            TextColor="White"
                            Command="{Binding WipeDatabaseCommand}" />

                    <Button Text="Export"
                            Command="{Binding Source={x:Reference DatabaseSettings}, Path=ExportDatabaseCommand}" />

                    <Button Text="Import"
                            Command="{Binding Source={x:Reference DatabaseSettings}, Path=ImportDatabaseCommand}" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
